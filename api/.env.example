# ===== Database =====
MONGO_URL=mongodb://127.0.0.1:27017/lenteraumat

# ===== Keamanan login =====
# Isi string acak panjang (min. 16 karakter). Contoh buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_DAYS=7

PORT=4000
# Alamat frontend (boleh lebih dari satu, pisahkan koma)
CLIENT_ORIGIN=http://localhost:5173
# true kalau frontend dan API beda domain (mis. Netlify + Render), wajib HTTPS
CROSS_SITE_COOKIE=false

# ===== Admin pertama (dibuat otomatis saat server mulai bila belum ada admin) =====
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ===== LUMA AI (Google Gemini) =====
# Buat key di https://aistudio.google.com/apikey  (JANGAN taruh key di kode frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Model cadangan bila model utama sibuk
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ===== Penyimpanan file =====
# Kosongkan = simpan di folder uploads/ (VPS). Isi untuk pakai Cloudinary:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Alamat publik API, dipakai untuk link file lokal. Kosongkan bila web & API satu domain.
PUBLIC_API_URL=
MAX_PDF_MB=40
# Batas ukuran file paket Cloudinary (gratis: 10 MB). PDF lebih besar dari tautan impor akan ditautkan ke sumbernya.
CLOUDINARY_MAX_MB=10

# ===== LUMA: batas per user per hari (admin tidak dibatasi, 0 = tanpa batas) =====
LUMA_DAILY_LIMIT=40

# ===== Email untuk "Lupa password" (Gmail) =====
# SMTP_USER = alamat Gmail pengirim. SMTP_PASS = App Password 16 huruf
# (myaccount.google.com/apppasswords, wajib 2-Step Verification aktif), BUKAN password Gmail biasa.
# Kosong = link reset hanya muncul di terminal API (untuk tes di laptop).
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Lentera Umat <emailkamu@gmail.com>
# Alamat web untuk link di email. Kosong = alamat pertama di CLIENT_ORIGIN.
APP_URL=
